{
  "name": "gw2-wvw-bingo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "preact-render-to-string": "^6.6.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
