{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gw2-wvw-bingo",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-10-25",
  "durable_objects": {
    "bindings": [
      {
        "name": "BINGO_ROOMS",
        "class_name": "BingoRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BingoRoom"
      ]
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "ROOM_CREATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "ROOM_JOIN_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
